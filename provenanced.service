[Unit]
Description=provenanced: track file provenance with extended attributes
After=local-fs.target
After=systemd-user-sessions.service

[Service]
Type=simple
ExecStart=/usr/local/bin/provenanced
Restart=on-failure
RestartSec=5
User=root
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=false
StandardOutput=journal
StandardError=journal
SyslogIdentifier=provenanced

[Install]
WantedBy=multi-user.target
